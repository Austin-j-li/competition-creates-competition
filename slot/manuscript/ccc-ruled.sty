% ccc-ruled.sty: the look of the talk "Competition Creates Competition".
% The ruled document: ink on paper, STIX Two Text for reading text, STIX Two
% Math for mathematics, Archivo for titles and chrome, a 2 pt ink rule under
% each frame title and above the title of the deck, hairlines elsewhere, no
% fills. The tokens are those of DESIGN.md at the repository root; the two
% concept colours (cInfo, cCost) belong to figures and their keys.
% Loaded by slides.tex after \documentclass{beamer}. The Archivo files sit in
% fonts/ beside OFL.txt; STIX Two comes from TeX Live. XeLaTeX.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ccc-ruled}[2026/10/26 the ruled-document look of the talk]
\usefonttheme{professionalfonts}
\setbeamersize{text margin left=10.95pt,text margin right=10.95pt}
\RequirePackage{fontspec}
\setmainfont{STIXTwoText}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-SemiBold,
  ItalicFont=*-Italic, BoldItalicFont=*-SemiBoldItalic]
\setsansfont{Archivo}[Path=fonts/, Extension=.ttf, UprightFont=*-Regular, BoldFont=*-SemiBold,
  ItalicFont=*-Italic, BoldItalicFont=*-SemiBoldItalic]
\renewcommand{\familydefault}{\rmdefault}
% The ruled-document tokens: ink and greys carry the reading text and chrome;
% the two concept colours belong to diagrams, figures and their keys.
\definecolor{cPaper}{HTML}{FBFCFC}
\definecolor{cInk}{HTML}{1E2530}
\definecolor{cMuted}{HTML}{5B6573}
\definecolor{cLine}{HTML}{C7CDD5}
\definecolor{cInfo}{HTML}{B54B00}
\definecolor{cCost}{HTML}{006459}
\setbeamercolor{background canvas}{bg=cPaper}
\setbeamercolor{normal text}{fg=cInk,bg=cPaper}
\setbeamercolor{structure}{fg=cInk}
\setbeamercolor{palette primary}{fg=cInk,bg=cPaper}
\setbeamercolor{palette secondary}{fg=cInk,bg=cPaper}
\setbeamercolor{palette tertiary}{fg=cInk,bg=cPaper}
\setbeamercolor{palette quaternary}{fg=cInk,bg=cPaper}
\setbeamercolor{frametitle}{fg=cInk,bg=cPaper}
\setbeamercolor{framesubtitle}{fg=cMuted,bg=cPaper}
\setbeamercolor{title}{fg=cInk,bg=cPaper}
\setbeamercolor{author}{fg=cInk}
\setbeamercolor{institute}{fg=cMuted}
\setbeamercolor{date}{fg=cMuted}
\setbeamercolor{footline}{fg=cMuted,bg=cPaper}
\setbeamercolor{page number in head/foot}{fg=cMuted}
\setbeamercolor{itemize item}{fg=cInk}
\setbeamercolor{itemize subitem}{fg=cMuted}
\setbeamercolor{itemize subsubitem}{fg=cMuted}
\setbeamercolor{enumerate item}{fg=cInk}
\setbeamercolor{enumerate subitem}{fg=cInk}
\setbeamercolor{block title}{fg=cInk,bg=cPaper}
\setbeamercolor{block body}{fg=cInk,bg=cPaper}
\setbeamercolor{block title alerted}{fg=cInk,bg=cPaper}
\setbeamercolor{block body alerted}{fg=cInk,bg=cPaper}
\setbeamercolor{block title example}{fg=cInk,bg=cPaper}
\setbeamercolor{block body example}{fg=cInk,bg=cPaper}
\setbeamercolor{button}{fg=cInk,bg=cPaper}
\setbeamercolor{button border}{fg=cInk}
\setbeamerfont{title}{family=\sffamily,series=\bfseries,size=\LARGE}
\setbeamerfont{author}{family=\sffamily,size=\large}
\setbeamerfont{institute}{family=\sffamily,size=\small}
\setbeamerfont{date}{family=\sffamily,size=\small}
\setbeamerfont{frametitle}{family=\sffamily,series=\bfseries,size=\large}
\setbeamerfont{framesubtitle}{family=\rmfamily,series=\mdseries,size=\small}
\setbeamerfont{footline}{family=\sffamily,size=\tiny}
\setbeamerfont{page number in head/foot}{family=\sffamily,size=\tiny}
\setbeamerfont{button}{family=\sffamily,size=\scriptsize}
\setbeamertemplate{button}{{\usebeamerfont{button}%
  \usebeamercolor[fg]{button}\underline{\insertbuttontext}}}
\setbeamerfont{block title}{family=\sffamily,series=\bfseries}
\setbeamertemplate{itemize item}{\raise0.2ex\hbox{\sffamily\small\textendash}}
\setbeamertemplate{itemize subitem}{\raise0.2ex\hbox{\sffamily\footnotesize\textendash}}
\setbeamertemplate{itemize subsubitem}{\raise0.2ex\hbox{\sffamily\footnotesize\textperiodcentered}}
\setbeamertemplate{enumerate item}{\sffamily\bfseries\insertenumlabel.}
\setbeamertemplate{enumerate subitem}{\sffamily\insertsubenumlabel.}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\RequirePackage{econ-slides-compat}
\makeatletter
\newlength{\ruled@prog}
\newlength{\ruled@rest}
% Frame head: the Archivo title on the left, the muted subtitle under it, then
% the rule: a 2 pt ink segment in proportion to the frame number over the
% full-width hairline. Backups carry the hairline alone.
\setbeamertemplate{frametitle}{%
  \ifx\insertframetitle\@empty\else
    \vspace{0.3em}
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}
    \ifx\insertframesubtitle\@empty\else
      \vspace{0.1em}{\usebeamerfont{framesubtitle}%
        \usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}\fi
    \vspace{0.32em}
    \ifbeamer@inappendix
      {\color{cLine}\rule{\linewidth}{0.4pt}}\par
    \else
      \setlength{\ruled@prog}{\dimexpr\linewidth*\value{framenumber}/\inserttotalframenumber\relax}%
      \setlength{\ruled@rest}{\dimexpr\linewidth-\ruled@prog\relax}%
      {\color{cInk}\rule{\ruled@prog}{2pt}}%
      {\color{cLine}\rule[0.8pt]{\ruled@rest}{0.4pt}}\par
    \fi
    \vspace{0.15em}
  \fi}
\setbeamertemplate{footline}{%
  \begin{beamercolorbox}[wd=\paperwidth,ht=2.2ex,dp=1.4ex,
      leftskip=\beamer@leftmargin,rightskip=\beamer@rightmargin]{footline}
    \usebeamerfont{footline}\insertshorttitle\hfill
    \insertframenumber\,/\,\inserttotalframenumber
  \end{beamercolorbox}}
% Title page: a 2 pt ink rule above the title, a hairline below it, the
% author and the institute in Archivo under the hairline.
\setbeamertemplate{title page}{%
  \vspace*{0.26\paperheight}
  {\color{cInk}\rule{\linewidth}{2pt}}\par\vspace{1.1em}
  {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
  \vspace{1.1em}{\color{cLine}\rule{\linewidth}{0.4pt}}\par\vspace{0.9em}
  {\usebeamerfont{author}\usebeamercolor[fg]{author}\insertauthor\par}
  \vspace{0.35em}
  {\usebeamerfont{institute}\usebeamercolor[fg]{institute}\insertinstitute\par}
  \ifx\insertdate\@empty\else
    \vspace{0.35em}{\usebeamerfont{date}\usebeamercolor[fg]{date}\insertdate\par}\fi
  \vfill}
\makeatother
\AtBeginDocument{\usebeamercolor{normal text}}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{unicode-math}
\setmathfont{STIX Two Math}
\setmathfont{STIX Two Math}[version=bold]
\RequirePackage{booktabs}
\setlength{\heavyrulewidth}{1.1pt}
\setlength{\lightrulewidth}{0.4pt}
\setlength{\cmidrulewidth}{0.4pt}
\RequirePackage{array}
\AtBeginEnvironment{tabular}{\sffamily}
