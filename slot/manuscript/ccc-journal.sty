% ccc-journal.sty: the look of the Beamer deck of "Competition Creates Competition".
% The journal look in the colours of UCL (chosen by the author on 11 November 2026 from four demos):
% Libertinus Serif for the reading text and Libertinus Math for the mathematics, DM Sans for frame
% titles, tags, the model strip and the footline, dark purple for titles and tags, bright purple for
% rules and bullets, and white paper on every page, the title page too. No bars,
% boxes, fills or rounded shapes. The layout is the journal look of 29 October 2026, which used
% Libertinus Sans and one oxblood accent. The website (the research brief page and the web slides
% under /talk/) follows this file through DESIGN.md.
% This file holds everything slides.tex needs: packages, fonts, colours, the frame title, the title
% page and the footline, the flat result statement, the frame skeleton (statement, intuition and foot
% zones), the label column, the model strip, the text links, the flow-step styles of the diagrams and
% the start of the backups. XeLaTeX (see latexmkrc).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ccc-journal}[2026/11/11 the journal look of the talk in the colours of UCL]
\usetheme{default}
\usefonttheme{professionalfonts}
\usefonttheme{serif}
\RequirePackage{econ-slides-compat}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{booktabs,array}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,decorations.pathreplacing}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% ---------------------------------------------------------------- Fonts
\RequirePackage{fontspec}
\setmainfont{Libertinus Serif}
% DM Sans (SIL Open Font Licence; UCL Sans is a cut of it) from fonts/dmsans/: four static cuts at
% optical size 14, with the semibold as the bold. It is scaled to sit beside Libertinus Serif. Without
% the font folder the deck falls back to Libertinus Sans.
\IfFileExists{fonts/dmsans/DMSans-Regular.ttf}{%
  \setsansfont{DMSans}[Path=fonts/dmsans/,Extension=.ttf,UprightFont=*-Regular,BoldFont=*-SemiBold,
    ItalicFont=*-Italic,BoldItalicFont=*-SemiBoldItalic,Scale=0.9]}{%
  \setsansfont{Libertinus Sans}}
\RequirePackage{unicode-math}
\setmathfont{Libertinus Math}
\setbeamerfont{frametitle}{family=\sffamily,series=\bfseries,size=\Large}
\setbeamerfont{framesubtitle}{family=\rmfamily,shape=\itshape,size=\small}
% The title page: the title, the subtitle (the second line of \title), the name and the department.
\setbeamerfont{title}{family=\rmfamily,series=\bfseries,size={\fontsize{25}{28}}}
\setbeamerfont{subtitle}{family=\rmfamily,series=\mdseries,size={\fontsize{16.5}{20}}}
\setbeamerfont{author}{family=\sffamily,series=\bfseries,size={\fontsize{11}{13}}}
\setbeamerfont{institute}{family=\sffamily,series=\mdseries,size={\fontsize{9}{11}}}
% The body of a main frame is \Body (\small), set at frame level right after \begin{frame}.
\newcommand{\Body}{\small}

% ---------------------------------------------------------------- Colours
% The purples are the official values of the UCL brand pages (read 11 November 2026). UCL's rules for
% them: dark purple for text and grounds; bright purple on white only. UCL's heritage blue and mid
% purple go on dark purple only, so the deck, which is white paper throughout, does not use them.
% So coloured text (the title, frame titles, tags, the current part, links) is dark purple
% (cAccent), and rules, bullets and the marks of a flow are bright purple (cRule). Ink for the reading
% text; greys for glosses, pointer lines and hairlines. The information and cost colours of the
% diagrams match the _talk figures.
\definecolor{cDark}{HTML}{361A54}
\definecolor{cBright}{HTML}{993BFF}
\colorlet{cAccent}{cDark}
\colorlet{cRule}{cBright}
\colorlet{cNavy}{cAccent}
\definecolor{cInk}{HTML}{1C1C1C}
\definecolor{cLine}{HTML}{C9C9C9}
\definecolor{cGrayText}{HTML}{666666}
\colorlet{cMuted}{cGrayText}
\colorlet{cPaper}{white}
\definecolor{cInfo}{HTML}{B54B00}
\definecolor{cCost}{HTML}{006459}
\setbeamercolor{normal text}{fg=cInk,bg=white}
\setbeamercolor{structure}{fg=cAccent}
\setbeamercolor{frametitle}{fg=cAccent,bg=white}
\setbeamercolor{framesubtitle}{fg=cGrayText}
\setbeamercolor{title}{fg=cInk}
\setbeamercolor{author}{fg=cInk}
\setbeamercolor{item}{fg=cRule}
\setbeamercolor{enumerate item}{fg=cAccent}
\setbeamercolor{itemize/enumerate body}{fg=cInk}
\setbeamercolor{itemize/enumerate subbody}{fg=cInk}
\setbeamercolor{description body}{fg=cInk}
\setbeamercolor{block title}{fg=cAccent,bg=white}
\setbeamercolor{block body}{fg=cInk,bg=white}
% econ-slides-compat selects the structure colour at the start of the document; reading text is ink.
\AtBeginDocument{\usebeamercolor[fg]{normal text}}

% ---------------------------------------------------------------- Frame furniture
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{itemize items}{\raise0.25ex\hbox{\scriptsize$\blacksquare$}}
\setbeamertemplate{enumerate items}{\textbf{\insertenumlabel.}}
\setbeamersize{text margin left=0.4cm,text margin right=0.4cm}
\setlength{\leftmargini}{1.1em}

% Frame title: bold sans in dark purple, optional italic subtitle in grey, then a 1 pt rule. Every frame
% starts its body at the same height under that rule.
\makeatletter
\setbeamertemplate{frametitle}{%
  \vskip0.08cm
  {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle\par}%
  \ifx\insertframesubtitle\@empty\else
    \vskip1pt{\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}\fi
  \vskip0.05cm{\color{cRule}\rule{\linewidth}{1pt}}\par\vskip-0.18cm}
\makeatother

% Title page: white paper with a 1.3 cm margin, as the title block of the website. At the head, a short
% bright purple rule, the title in bold serif and the subtitle in regular serif, in dark purple. At the
% foot, a grey hairline, the name in bold sans in ink and the department in grey. The author chose
% purple type on white over white type on purple. The page reads the line break of \title as the end of the
% title and the start of the subtitle, and the line break of \author as the end of the name and the
% start of the department. The positions are in cm from the lower left corner of the 16 by 9 cm page.
% The page is an overlay, so it needs two runs. TikZ sets a fixed word space for ragged text at the size
% in force when the node starts; \ccc@wordspace gives each line the word space of its own font.
% The \par inside each node ends the last line while its own line spacing is in force.
\makeatletter
\newcommand{\ccc@wordspace}{\spaceskip\z@skip\xspaceskip\z@skip}
\newcommand{\ccc@titlebreak}[1][0pt]{\par\vskip5.6pt\usebeamerfont{subtitle}}
\newcommand{\ccc@authorbreak}[1][0pt]{\par\vskip2.7pt\usebeamerfont{institute}\color{cGrayText}\let\normalsize\relax}
\tikzset{ccc cover/.style={inner sep=0pt,outer sep=0pt,anchor=base west,text width=13.4cm,align=left}}
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay,x=1cm,y=1cm,shift={(current page.south west)}]
    \fill[cRule] (1.3,7.55) rectangle (3.5,7.62);
    \node[ccc cover,text=cAccent] at (1.3,6.45) {\ccc@wordspace\let\\\ccc@titlebreak\usebeamerfont{title}\inserttitle\par};
    \draw[cLine,line width=0.5pt] (1.3,1.95) -- (14.7,1.95);
    \node[ccc cover,text=cInk] at (1.3,1.38) {\ccc@wordspace\let\\\ccc@authorbreak\usebeamerfont{author}\insertauthor\par};
  \end{tikzpicture}}
\makeatother

% Footline: the roadmap on a main frame and the short title on a backup, in sans on the left; text
% links, then the frame number (a backup shows its backup id) on the right. \PlaceNav stores the links
% for the page it is called on. A link is sans text in dark purple after a small triangle: no box, no
% fill, no rounded corner.
\makeatletter
\gdef\ccc@nav{}
\gdef\ccc@bid{}
\newcommand{\BackupId}[1]{\gdef\ccc@bid{#1}}
\renewcommand{\PlaceNav}[1]{\gdef\ccc@nav{#1}}
\renewcommand{\beamergotobutton}[1]{{\sffamily\scriptsize\color{cAccent}\raise0.05ex\hbox{\fontsize{6}{6}\selectfont$\blacktriangleright$}\hspace{0.2em}#1}}
\renewcommand{\beamerreturnbutton}[1]{{\sffamily\scriptsize\color{cAccent}\raise0.05ex\hbox{\fontsize{6}{6}\selectfont$\blacktriangleleft$}\hspace{0.2em}#1}}
\renewcommand{\BackButton}[1]{\gdef\ccc@nav{\hyperlink{#1}{\beamerreturnbutton{Back}}}}
\newcommand{\NavSep}{\hspace{0.9em}}
% The roadmap: the parts of the talk in the left slot of the footline of a main frame; the current part
% in bold accent, the others grey. slides.tex defines \RoadItems.
\newcommand{\RoadItem}[3]{\ifnum\c@framenumber<#1\relax{\color{cGrayText}#3}\else\ifnum\c@framenumber>#2\relax{\color{cGrayText}#3}\else{\color{cAccent}\bfseries #3}\fi\fi}
\newcommand{\RoadSep}{\hspace{0.55em}{\color{cLine}\textbullet}\hspace{0.55em}}
\setbeamertemplate{footline}{%
  \leavevmode\hbox{\hspace*{0.4cm}%
  \begin{beamercolorbox}[wd=\dimexpr\paperwidth-0.8cm\relax,ht=1.9ex,dp=0.9ex]{normal text}%
    \ifbeamer@inappendix{\sffamily\scriptsize\color{cGrayText}\insertshorttitle}\else\ifdefined\RoadItems{\sffamily\scriptsize\RoadItems}\else{\sffamily\scriptsize\color{cGrayText}\insertshorttitle}\fi\fi\hfill
    \ccc@nav\hspace*{0.9em}{\sffamily\scriptsize\color{cGrayText}\ifbeamer@inappendix\ccc@bid\else\insertframenumber{} / \inserttotalframenumber\fi}%
  \end{beamercolorbox}}%
  \vskip1pt\global\let\ccc@nav\@empty}
\makeatother

% ---------------------------------------------------------------- Rules and the result statement
% Rules start a paragraph before they colour anything: Beamer inserts the frame title at the first
% paragraph of a frame, and a colour group there displaces it.
\newcommand{\NavyRule}{\par\noindent\textcolor{cRule}{\rule{\linewidth}{0.8pt}}\par}
\newcommand{\LightRule}{\par\noindent\textcolor{cLine}{\rule{\linewidth}{0.4pt}}\par}
% A result statement prints as a theorem statement: a rule, a bold sans tag in dark purple, the
% body one size below \Body, a light closing rule. No fill, rounded corners or shadow. A plain
% environment, not a Beamer block: a block at the top of a [t] frame adds its own vertical gap.
%   \begin{Statement}{Proposition 2} ... \end{Statement}
\newenvironment{Statement}[1]{\vspace{-2pt}\NavyRule\vskip1pt
  \noindent{\sffamily\bfseries\small\color{cAccent}#1}\par\vskip2pt\footnotesize\noindent\ignorespaces}{%
  \par\vspace{2pt}\LightRule}
% The Beamer block prints the same way, for any frame that still uses it.
\setbeamertemplate{block begin}{%
  \par\vskip\smallskipamount
  {\color{cRule}\rule{\linewidth}{0.8pt}}\par\vskip2pt
  \noindent{\sffamily\bfseries\small\color{cAccent}\insertblocktitle}\par\vskip3pt\noindent\ignorespaces}
\setbeamertemplate{block end}{%
  \par\vspace{3pt}{\color{cLine}\rule{\linewidth}{0.4pt}}\par\vskip\smallskipamount}
\newcommand{\ResultTag}[1]{#1}

% ---------------------------------------------------------------- Frame skeleton
% The intuition or takeaway is pinned above the foot zone by \vfill, so it sits at one height on every
% frame that has one. The foot zone holds grey pointer lines in small type. \Gloss is a grey sentence
% beside or under a hypothesis.
\newcommand{\Intuition}[1]{\par\vfill\LightRule\vspace{0.1em}{\small\itshape\raggedright #1\par}}
\newcommand{\TakeawayEnd}[1]{\par\vfill\NavyRule\vspace{0.2em}\noindent{\raggedright\textbf{#1}\par}}
\renewcommand{\Takeaway}[1]{\TakeawayEnd{#1}}
\newcommand{\FootLine}[1]{\par\vspace{0.15em}{\color{cGrayText}\scriptsize\raggedright #1\par}}
\newcommand{\SmallLine}[1]{\FootLine{#1}}
\newcommand{\GrayLine}[1]{\par{\color{cGrayText}\footnotesize #1\par}}
\newcommand{\Gloss}[1]{\par{\color{cGrayText}\footnotesize\raggedright #1\par}}
\newcommand{\TightMath}{\setlength{\abovedisplayskip}{3pt plus 1pt}\setlength{\belowdisplayskip}{3pt plus 1pt}%
  \setlength{\abovedisplayshortskip}{1pt}\setlength{\belowdisplayshortskip}{2pt plus 1pt}}
% The large line of frames 3 and 20: one large bold statement between an accent rule and a light rule.
\newcommand{\LargeLine}[1]{\par{\color{cRule}\rule{\linewidth}{0.8pt}}\par\vspace{0.35em}%
  \noindent{\raggedright\large\textbf{#1}\par}\vspace{0.35em}{\color{cLine}\rule{\linewidth}{0.4pt}}\par}
% A label column: bold sans labels on the left, text on the right. \DefRow{label}{text} inside \DefList.
\newenvironment{DefList}[1][2.9cm]{\par\begin{tabular}{@{}>{\raggedright\arraybackslash}p{#1}@{\hspace{0.45em}}>{\raggedright\arraybackslash}p{\dimexpr\linewidth-#1-0.45em\relax}@{}}}{\end{tabular}\par}
\newcommand{\DefRow}[2]{{\sffamily\bfseries #1} & #2\\[2pt]}
% A column with a bold sans head above an accent rule (frame 1 and backup B6).
\newcommand{\RuledCol}[1]{\par\noindent\textcolor{cRule}{\rule{\linewidth}{0.6pt}}\par\vspace{0.35em}{\raggedright #1\par}}
\newcommand{\ColHead}[1]{\noindent{\sffamily\bfseries\color{cAccent}#1}\par\vspace{0.2em}{\color{cRule}\rule{\linewidth}{0.6pt}}\par\vspace{0.35em}}

% ---------------------------------------------------------------- Model strip
% Under the frame title of frames 5 to 9: the six parts of the model; the current ones in bold accent,
% the others grey. \ModelStrip{3,4}.
\makeatletter
\newcommand{\ModelStrip}[1]{\edef\ccc@cur{,#1,}%
  \par\vspace{-0.1em}{\sffamily\footnotesize\noindent
  \ccc@strip{1}{Players}\ccc@stripsep\ccc@strip{2}{Timing}\ccc@stripsep\ccc@strip{3}{Information}\ccc@stripsep
  \ccc@strip{4}{Actions}\ccc@stripsep\ccc@strip{5}{Payoffs}\ccc@stripsep\ccc@strip{6}{Equilibrium}\par}
  \vspace{0.35em}}
\newcommand{\ccc@strip}[2]{\edef\ccc@test{\noexpand\in@{,#1,}{\ccc@cur}}\ccc@test
  \ifin@{\color{cAccent}\textbf{#2}}\else{\color{cGrayText}#2}\fi}
\newcommand{\ccc@stripsep}{\hfill{\color{cLine}\textbullet}\hfill}
\makeatother

% ---------------------------------------------------------------- Diagrams
% A step of a flow is text under a rule: no frame, no fill, no rounded corner. The names flowbox and
% flowcost stay, because slides.tex uses them.
\tikzset{
  flowbox/.style={draw=none, fill=none, align=left,
    font={\footnotesize\hyphenpenalty=10000\relax}, inner xsep=0pt, inner ysep=5pt, outer xsep=3pt,
    path picture={\draw[cRule,line width=1.6pt] (path picture bounding box.north west) -- (path picture bounding box.north east);}},
  flowcost/.style={flowbox,
    path picture={\draw[cInk,line width=1.6pt] (path picture bounding box.north west) -- (path picture bounding box.north east);}},
  flowarr/.style={-{Stealth[length=5pt]}, line width=0.6pt, black!55}}

% Backups: no divider frame and no frame number.
\newcommand{\BackupStart}{\appendix}
\endinput
