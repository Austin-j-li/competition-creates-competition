% ccc-classic.sty: the look of the Beamer deck of "Competition Creates Competition".
% Rule (28 October 2026): the slide deck in Overleaf uses a stock classic Beamer theme (Madrid).
% The website (the research brief page and the web slides under /talk/) keeps the ruled document
% of DESIGN.md. A change to the Overleaf slides keeps this theme; it never brings the ruled look
% into Beamer.
% This file adds only what slides.tex needs on top of the stock theme: packages, the colour names
% the frames use, the takeaway, foot and small lines, the link buttons in the footline, the
% flow-box styles of the diagrams, and the start of the backups. XeLaTeX (see latexmkrc).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ccc-classic}[2026/10/28 classic Beamer look of the talk]
\usetheme{Madrid}
\RequirePackage{econ-slides-compat}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamersize{text margin left=0.4cm,text margin right=0.4cm}
\RequirePackage{amsmath,amssymb,mathtools}
\RequirePackage{booktabs,array}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,decorations.pathreplacing}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% Colour names used in the frames. Text and rules follow the theme; the information and cost
% colours match the _talk figures.
\colorlet{cInk}{black}
\colorlet{cMuted}{black!60}
\colorlet{cGrayText}{black!60}
\colorlet{cLine}{black!25}
\colorlet{cPaper}{white}
\definecolor{cInfo}{HTML}{B54B00}
\definecolor{cCost}{HTML}{006459}
\setbeamercolor{button}{bg=white,fg=structure.fg}
% econ-slides-compat selects the structure colour at the start of the document; reading text is
% the theme's normal text colour.
\AtBeginDocument{\usebeamercolor[fg]{normal text}}

% The takeaway: one bold line at the foot of the body after a clear gap, in the theme's block-title
% box. The foot zone under it holds citations, credits and scope limits in small type.
\newcommand{\TakeawayEnd}[1]{\par\vfill\noindent
  \begin{beamercolorbox}[rounded=true,shadow=true,wd=\linewidth,sep=0.1cm]{block title}%
    \raggedright\textbf{#1}\par
  \end{beamercolorbox}\par}
\newcommand{\FootLine}[1]{\par\vspace{0.25em}{\color{cGrayText}\scriptsize\raggedright #1\par}}
\newcommand{\SmallLine}[1]{\par{\color{cGrayText}\footnotesize\raggedright #1\par}}
\newcommand{\GrayLine}[1]{\par{\color{cGrayText}\footnotesize #1\par}}
% A column under a thin rule in the structure colour.
\newcommand{\RuledCol}[1]{{\usebeamercolor[fg]{structure}\rule{\linewidth}{0.6pt}}\par\vspace{0.35em}{\raggedright #1\par}}
\newcommand{\NavSep}{\hspace{0.35em}}

% Link buttons sit in the right box of the footline, beside the frame number, so they take no
% height from the frame body. \PlaceNav stores them for the page it is called on.
\makeatletter
\gdef\ccc@nav{}
\renewcommand{\PlaceNav}[1]{\gdef\ccc@nav{#1}}
\renewcommand{\BackButton}[1]{\gdef\ccc@nav{\hyperlink{#1}{\beamerreturnbutton{Back}}}}
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
  \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{author in head/foot}%
    \usebeamerfont{author in head/foot}\insertshortauthor
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,center]{title in head/foot}%
    \usebeamerfont{title in head/foot}\insertshorttitle
  \end{beamercolorbox}%
  \begin{beamercolorbox}[wd=.333333\paperwidth,ht=2.25ex,dp=1ex,right]{date in head/foot}%
    \usebeamerfont{date in head/foot}\ccc@nav\hspace*{1.5em}%
    \ifbeamer@inappendix\else\insertframenumber{} / \inserttotalframenumber\fi\hspace*{2ex}
  \end{beamercolorbox}}%
  \vskip0pt%
  \global\let\ccc@nav\@empty}
\makeatother

% The diagrams of frames S5, S7 and S15: rounded boxes in the structure colour; the cost box in
% the cost colour.
\tikzset{
  flowbox/.style={draw=structure.fg, line width=0.5pt, rounded corners=2pt, fill=structure.fg!6, align=left,
    font={\footnotesize\hyphenpenalty=10000\relax}, inner xsep=4pt, inner ysep=4pt},
  flowcost/.style={flowbox, draw=cCost, fill=cCost!6},
  flowarr/.style={-{Stealth[length=5pt]}, line width=0.6pt, black!55}}

% Backups: no divider frame and no frame number.
\newcommand{\BackupStart}{\appendix}
\endinput
