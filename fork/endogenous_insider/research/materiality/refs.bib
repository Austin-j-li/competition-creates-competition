% ---------- Legal sources ----------

@misc{TSCNorthway1976,
  title  = {{TSC Industries, Inc. v. Northway, Inc.}},
  howpublished = {426 U.S. 438},
  year   = {1976},
  note   = {U.S. Supreme Court. Materiality: substantial likelihood that a reasonable shareholder would consider the fact important; ``total mix'' of information (at 449). verified},
  url    = {https://supreme.justia.com/cases/federal/us/426/438/}
}

@misc{TexasGulfSulphur1968,
  title  = {{SEC v. Texas Gulf Sulphur Co.}},
  howpublished = {401 F.2d 833 (2d Cir. 1968) (en banc)},
  year   = {1968},
  note   = {Materiality of a contingent event depends on ``a balancing of both the indicated probability that the event will occur and the anticipated magnitude of the event in light of the totality of the company activity''; disclose-or-abstain rule. verified},
  url    = {https://law.justia.com/cases/federal/appellate-courts/F2/401/833/324140/}
}

@misc{BasicLevinson1988,
  title  = {{Basic Inc. v. Levinson}},
  howpublished = {485 U.S. 224},
  year   = {1988},
  note   = {U.S. Supreme Court. Adopts the TSC standard for Rule 10b-5 (at 231); applies the Texas Gulf Sulphur probability/magnitude balancing to merger negotiations (at 238); indicia of interest at the highest corporate levels (at 239); rejects the agreement-in-principle test (at 236). verified},
  url    = {https://www.law.cornell.edu/supremecourt/text/485/224}
}

@misc{Chiarella1980,
  title  = {{Chiarella v. United States}},
  howpublished = {445 U.S. 222},
  year   = {1980},
  note   = {U.S. Supreme Court. Classical theory: a duty to disclose under section 10(b) does not arise from the mere possession of nonpublic market information (at 235); liability requires a relationship of trust and confidence between the parties to the transaction (at 230). verified},
  url    = {https://www.law.cornell.edu/supremecourt/text/445/222}
}

@misc{Dirks1983,
  title  = {{Dirks v. SEC}},
  howpublished = {463 U.S. 646},
  year   = {1983},
  note   = {U.S. Supreme Court. Tippee liability is derivative of the insider's breach; the test is whether the insider personally benefits from the disclosure (at 662). verified},
  url    = {https://caselaw.findlaw.com/court/us-supreme-court/463/646.html}
}

@misc{OHagan1997,
  title  = {{United States v. O'Hagan}},
  howpublished = {521 U.S. 642},
  year   = {1997},
  note   = {U.S. Supreme Court. Misappropriation theory: fraud ``in connection with'' a securities transaction when a person misappropriates confidential information for trading, in breach of a duty owed to the source (at 652); full disclosure to the source forecloses liability (at 655); Rule 14e-3(a) is within the SEC's section 14(e) authority without a breach of fiduciary duty (at 673). verified},
  url    = {https://supreme.justia.com/cases/federal/us/521/642/}
}

@misc{Rule14e3,
  title  = {Transactions in securities on the basis of material, nonpublic information in the context of tender offers},
  howpublished = {17 C.F.R. \S\,240.14e-3},
  year   = {1980},
  note   = {Triggered once any person ``has taken a substantial step or steps to commence, or has commenced, a tender offer''; reaches any other person in possession of material nonpublic information relating to the offer that was acquired directly or indirectly from the offering person, the issuer, or persons acting for them. verified},
  url    = {https://www.law.cornell.edu/cfr/text/17/240.14e-3}
}

@misc{SECRelease17120,
  author = {{Securities and Exchange Commission}},
  title  = {Tender Offers; Adoption of Rule 14e-3},
  howpublished = {Exchange Act Release No. 34-17120},
  year   = {1980},
  month  = {September 12},
  note   = {Lists examples of substantial steps: a board vote on a resolution relating to the offer, formulation of a plan or proposal to make the offer, arranging financing, preparing offer materials, authorizing negotiations with a dealer-manager, soliciting dealer, forwarding agent or depository. verified},
  url    = {https://www.sec.gov/files/corpfin/34-17120.pdf}
}

@misc{Rule10b51,
  title  = {Trading ``on the basis of'' material nonpublic information in insider trading cases},
  howpublished = {17 C.F.R. \S\,240.10b5-1},
  year   = {2000},
  note   = {Paragraph (b): a trade is on the basis of material nonpublic information if the trader was aware of the information when the trade was made. verified},
  url    = {https://www.law.cornell.edu/cfr/text/17/240.10b5-1}
}

